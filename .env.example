# === IMBRACE SDK CONFIGURATION ===
#
# Copy this file to `.env` and fill in your own values.
# The same variables are read by both the TypeScript and the Python SDK.
#
#   cp .env.example .env
#
# `.env` is git-ignored — never commit real credentials.

# --- 1. Environment selection -------------------------------------------------
# Options: develop | sandbox | stable (default)
IMBRACE_ENV=stable

# --- 2. Gateway URL override (optional) ---------------------------------------
# The SDK picks the right gateway from IMBRACE_ENV automatically.
# Set this only to point at something else (e.g. a local gateway).
#   develop: https://app-gateway.dev.imbrace.co
#   sandbox: https://app-gateway.sandbox.imbrace.co
#   stable:  https://app-gatewayv2.imbrace.co
IMBRACE_GATEWAY_URL=

# --- 3. Authentication --------------------------------------------------------
# Use ONE of the two. Get either from the Imbrace Portal.
#
# API key — server-side use. Organization context is encoded in the key,
# so IMBRACE_ORGANIZATION_ID is not needed when you use this.
IMBRACE_API_KEY=

# Access token — JWT/OAuth flows, or client-side use.
# IMBRACE_ACCESS_TOKEN=

# --- 4. Organization context (optional) ---------------------------------------
# Sends x-organization-id on every request. Required with an access token
# when your account belongs to more than one organization.
IMBRACE_ORGANIZATION_ID=

# --- 5. Client options (optional) ---------------------------------------------
# Ping the gateway when the client is constructed.
IMBRACE_CHECK_HEALTH=false

# Request timeout in seconds.
IMBRACE_TIMEOUT=30

# Verbose SDK logging.
DEBUG=false
